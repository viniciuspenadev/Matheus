# =============================================================================
# StudyFlow AI — variáveis de ambiente
# Copie para .env.local (site) e preencha. NUNCA versione credenciais reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Etapa 1 (obrigatório)
# Painel do Supabase → Project Settings → API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...). A chave "anon" legada também funciona
# (use NEXT_PUBLIC_SUPABASE_ANON_KEY no lugar). Segura para o navegador: o
# acesso aos dados é limitado pelas políticas de RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Chave secreta (sb_secret_...) ou service_role legada. SOMENTE servidor/worker
# e scripts locais (npm run setup:user). Nunca use em variável NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# E-mails autorizados a entrar (separados por vírgula). Vazio = ninguém entra.
ALLOWED_EMAILS=voce@exemplo.com

# Fuso horário para exibição de datas.
APP_TIMEZONE=America/Sao_Paulo

# -----------------------------------------------------------------------------
# OpenAI — Etapas 2 e 3 (worker). Ainda não utilizadas na Etapa 1.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-5.6-luna
# Modelo usado se o principal não estiver disponível na conta.
OPENAI_TEXT_MODEL_FALLBACK=gpt-5-mini

# -----------------------------------------------------------------------------
# Pesquisa acadêmica — Etapa 4. OpenAlex e Crossref não exigem chave, mas pedem
# um e-mail de contato para o "polite pool" (melhor desempenho).
# -----------------------------------------------------------------------------
ACADEMIC_CONTACT_EMAIL=
GOOGLE_BOOKS_API_KEY=

# -----------------------------------------------------------------------------
# Limites e custos — usados a partir da Etapa 2 (worker). São o TETO; as
# configurações do usuário só podem ser mais restritivas.
# -----------------------------------------------------------------------------
MONTHLY_BUDGET_USD=10
MAX_AUDIO_HOURS_PER_MONTH=40
MAX_LESSONS_PER_MONTH=60
MAX_RESEARCH_TOPICS_PER_LESSON=5
MAX_SOURCES_PER_TOPIC=3
AUTO_DELETE_AUDIO=true
AUDIO_RETENTION_HOURS=0

# Tarifas para ESTIMATIVA de custo (USD). Valores de referência: CONFIRME na
# página oficial de preços da OpenAI antes de usar e atualize quando mudarem.
PRICE_TRANSCRIPTION_PER_MINUTE_USD=0.006
PRICE_TEXT_INPUT_PER_MTOK_USD=0.20
PRICE_TEXT_OUTPUT_PER_MTOK_USD=1.20
